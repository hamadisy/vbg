NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173
# Used to build the case link in SMS notifications - no trailing slash.
FRONTEND_URL=http://localhost:5173

DB_STORAGE=./data/vbg-dev.sqlite

JWT_ACCESS_SECRET=change-me-in-every-environment
JWT_ACCESS_EXPIRES_IN=8h

BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

MAIL_PROVIDER=stub

# SMS_PROVIDER=stub logs instead of sending. Set to "vonage" + fill in
# credentials below once a real Vonage account exists.
SMS_PROVIDER=stub
# Every send attempt (success or failure, with reason) is appended here as JSON lines.
SMS_LOG_FILE=./logs/sms.log
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SMS_SENDER_ID=VBG

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_EMAIL=admin@csvvdh.local

# Shared placeholder password for the operational demo users (relay1,
# director-a, etc). Bcrypt can't reproduce their real passwords, so rotate
# each one via the Users admin page after seeding.
SEED_USER_PASSWORD=ChangeMe123!
