    "@mui/x-date-pickers": "^9.8.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "dayjs": "^1.11.21",
    "i18next": "^26.3.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-i18next": "^17.0.8",
